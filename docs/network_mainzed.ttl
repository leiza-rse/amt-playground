@prefix mainzed: <http://mainzed.org/> .
@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <http://mainzed.org/example/> .

# A small starting network for the playground (invented persons, for illustration).
# Edges are reified statements with a weight in (0, 1].

ex:ada a mainzed:Person ; rdfs:label "Lovelace, Ada" .
ex:grace a mainzed:Person ; rdfs:label "Hopper, Grace" .
ex:tim a mainzed:Person ; rdfs:label "Berners-Lee, Tim" .

ex:lod a mainzed:Interest ; rdfs:label "Linked Data" .
ex:sw a mainzed:Interest ; rdfs:label "Semantic Web" .
ex:ai a mainzed:Interest ; rdfs:label "Symbolic AI" .

[] a rdf:Statement ; rdf:subject ex:ada ; rdf:predicate mainzed:interestedIn ; rdf:object ex:ai ; amt:weight 0.9 .
[] a rdf:Statement ; rdf:subject ex:grace ; rdf:predicate mainzed:interestedIn ; rdf:object ex:ai ; amt:weight 0.6 .
[] a rdf:Statement ; rdf:subject ex:tim ; rdf:predicate mainzed:interestedIn ; rdf:object ex:lod ; amt:weight 1.0 .
[] a rdf:Statement ; rdf:subject ex:lod ; rdf:predicate mainzed:subInterestOf ; rdf:object ex:sw ; amt:weight 0.8 .
[] a rdf:Statement ; rdf:subject ex:sw ; rdf:predicate mainzed:subInterestOf ; rdf:object ex:ai ; amt:weight 0.5 .
